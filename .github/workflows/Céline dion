name: JOE Celine monitor

on:
  workflow_dispatch:

jobs:
  test-hooktap:
    runs-on: ubuntu-latest

    steps:
      - name: Test HookTap
        env:
          HOOKTAP_URL: ${{ secrets.HOOKTAP_WEBHOOK_URL }}
        run: |
          python - <<'PY'
          import os
          import requests

          hooktap = os.environ["HOOKTAP_URL"]

          response = requests.post(
              hooktap,
              json={
                  "type": "push",
                  "title": "✅ TEST GELUKT!",
                  "body": "GitHub is succesvol verbonden met HookTap. De JOE-monitor kan worden ingesteld."
              },
              timeout=20
          )

          print("Status:", response.status_code)
          print("Antwoord:", response.text)

          response.raise_for_status()
          PY
